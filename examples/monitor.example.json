        "max_price": 5000,
        "defer_below_price": 100,
        "rules": [
          {"pattern": "相机", "ceiling": 4000, "group": "camera", "fields": ["title"]},
          {"pattern": "镜头", "ceiling": 2000, "group": "lens", "fields": ["title"]}
        ]
      },
      "search_policy": {"sorts": ["新发布", "新降价"], "publish_window": "3天内", "sweep_every": 7},
      "baseline_refs": [{"item": {"id": "111111111", "title": "合成基准相机（测试数据）", "price": 4000}, "source": "synthetic example, replace before activation"}],
      "watch_items": [],
      "schedule": {"timezone": "Asia/Taipei", "time": "10:30"},
      "duration_days": 14
    },
    {
      "monitor_id": "desk-example",
      "enabled": false,
      "queries": [{"keyword": "书桌"}],
      "criteria": {"goal": "小书房书桌，尺寸与运费需核实", "max_price": 1200},
      "baseline_refs": [{"item": {"id": "222222222", "title": "合成书桌（测试数据）", "price": 1000}, "source": "synthetic example, replace before activation"}],
      "watch_items": [],
      "duration_days": 14
    }
  ]
