{
  "schema": 2,
  "runtime": {
    "reader_file": "/absolute/path/to/agent-browser-read.py",
    "cdp": "http://127.0.0.1:9222",
    "sender": "/absolute/path/to/confirmed-sender",
    "ai": {
      "url": "https://api.example.invalid/chat/completions",
      "model": "configured-model",
      "key_env": "MONITOR_AI_KEY",
      "cost_cap_usd": 3,
      "input_usd_per_million_ceiling": 1,
      "output_usd_per_million_ceiling": 2
    }
  },
  "monitors": [
    {
      "monitor_id": "camera-example",
      "enabled": false,
      "queries": [{"keyword": "旅行相机"}],
